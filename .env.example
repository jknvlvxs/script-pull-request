# Copie para .env e preencha. O .env é ignorado pelo git (ver .gitignore).
# O generate_pr.sh carrega este arquivo automaticamente (ou use GENERATE_PR_ENV_FILE
# para apontar para outro caminho).

# API key da Generative Language API (Google AI Studio).
GEMINI_API_KEY=

# Modelo padrão (opcional). Veja os disponíveis com: ./generate_pr.sh --list-models
GEMINI_MODEL=gemini-3.5-flash

# Provedor de IA padrão: claude | gemini
AI_PROVIDER=claude

# Modelo Claude padrão: sonnet | opus | haiku (ou um ID completo, ex.: claude-opus-5-5)
CLAUDE_MODEL=opus

# API key da Anthropic (opcional). Sem ela, o Claude é usado pelo claude CLI
# (Claude Code), com a conta em que você já está logado.
ANTHROPIC_API_KEY=

# Preferências. Sem elas, o script pergunta uma vez no terminal e grava a resposta
# no ~/.config/generate_pr/.env; para mudar depois, edite o valor lá.
# Publicar a descrição gerada direto no PR (false = mostrar para revisão antes).
# AUTO_PUBLISH_DESCRIPTION=true
# Abrir o PR no navegador ao terminar (só quando roda num terminal).
# OPEN_PR_IN_BROWSER=true
