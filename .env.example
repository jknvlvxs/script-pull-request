# Copie para .env e preencha. O .env é ignorado pelo git (ver .gitignore).
# O generate_pr.sh carrega este arquivo automaticamente (ou use GENERATE_PR_ENV_FILE
# para apontar para outro caminho).

# API key da Generative Language API (Google AI Studio).
GEMINI_API_KEY=

# Modelo padrão (opcional). Veja os disponíveis com: ./generate_pr.sh --list-models
GEMINI_MODEL=gemini-3.5-flash
